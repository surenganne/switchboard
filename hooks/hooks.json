{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/switchboard/hook_session.py\"", "timeout": 10}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/switchboard/hook_prompt.py\"", "timeout": 5}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Agent|Task|mcp__plugin_switchboard_switchboard__route|mcp__plugin_switchboard_switchboard__record_choice",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/switchboard/hook_pretool.py\"", "timeout": 10}]
      }
    ]
  }
}
